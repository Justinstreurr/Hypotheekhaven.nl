{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/blog/:slug.html", "destination": "/blog/:slug", "permanent": true },
    { "source": "/:pagina.html", "destination": "/:pagina", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/(Welkom|welkom){/index.php}?{/}?", "destination": "/", "statusCode": 301 },
    { "source": "/www-hypotheekhaven-nl/sitemap-xml{/index.php}?{/}?", "destination": "/", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken){/index.php}?{/}?", "destination": "/diensten", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Eerste-woning-kopen|eerste-woning-kopen){/index.php}?{/}?", "destination": "/diensten#eerste-huis", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Eerste-woning-kopen|eerste-woning-kopen)/(NHG|nhg){/index.php}?{/}?", "destination": "/diensten#eerste-huis", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Eerste-woning-kopen|eerste-woning-kopen)/(Schenking|schenking){/index.php}?{/}?", "destination": "/diensten#eerste-huis", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Eerste-woning-kopen|eerste-woning-kopen)/(Starterslening|starterslening){/index.php}?{/}?", "destination": "/diensten#eerste-huis", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Volgende-woning-kopen|volgende-woning-kopen){/index.php}?{/}?", "destination": "/diensten#verhuizen", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Hypotheek-meenemen|hypotheek-meenemen){/index.php}?{/}?", "destination": "/diensten#verhuizen", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Hypotheek-scheiden|hypotheek-scheiden){/index.php}?{/}?", "destination": "/diensten#scheiden", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Hypotheek-oversluiten|hypotheek-oversluiten){/index.php}?{/}?", "destination": "/diensten#oversluiten", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Overwaarde-opnemen|overwaarde-opnemen){/index.php}?{/}?", "destination": "/diensten#overwaarde", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Rentevast-periode-loopt-af|rentevast-periode-loopt-af){/index.php}?{/}?", "destination": "/diensten#rentevast", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Woning-verbouwen|woning-verbouwen){/index.php}?{/}?", "destination": "/diensten#verbouwen-of-verhuizen", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Woning-verduurzamen|woning-verduurzamen){/index.php}?{/}?", "destination": "/diensten#verduurzamen", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Ik-ben-ondernemer|ik-ben-ondernemer){/index.php}?{/}?", "destination": "/diensten#ondernemer", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Ik-ga-met-pensioen|ik-ga-met-pensioen){/index.php}?{/}?", "destination": "/diensten", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/(Mijn-partner-is-overleden|mijn-partner-is-overleden){/index.php}?{/}?", "destination": "/diensten", "statusCode": 301 },
    { "source": "/Verzekeringen/", "destination": "/verzekeringen", "statusCode": 301 },
    { "source": "/(Verzekeringen|verzekeringen)/index.php{/}?", "destination": "/verzekeringen", "statusCode": 301 },
    { "source": "/(Meer-nieuws-tips|meer-nieuws-tips){/index.php}?{/}?", "destination": "/blog", "statusCode": 301 },
    { "source": "/(Meer-nieuws-tips|meer-nieuws-tips)/(Hypotheekregels-2025-Wat-Verandert-er-en-Wat-Betekent-Dit-voor-Jou|hypotheekregels-2025-wat-verandert-er-en-wat-betekent-dit-voor-jou){/index.php}?{/}?", "destination": "/blog/maximale-hypotheek-2027-nieuwe-leennormen", "statusCode": 301 },
    { "source": "/(Meer-nieuws-tips|meer-nieuws-tips)/(Tip-Starters-hoeven-kansen-niet-te-liggen|tip-starters-hoeven-kansen-niet-te-liggen){/index.php}?{/}?", "destination": "/diensten#eerste-huis", "statusCode": 301 },
    { "source": "/(Meer-nieuws-tips|meer-nieuws-tips)/(Zekerheid-bij-het-kopen-van-een-huis-voorkom-onnodige-risico-s|zekerheid-bij-het-kopen-van-een-huis-voorkom-onnodige-risico-s){/index.php}?{/}?", "destination": "/blog", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven){/index.php}?{/}?", "destination": "/over-sabrina", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/(Geldverstrekkers|geldverstrekkers){/index.php}?{/}?", "destination": "/over-sabrina", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/(Vergelijkingskaarten|vergelijkingskaarten){/index.php}?{/}?", "destination": "/werkwijze#documenten", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/(Privacy-Statement|privacy-statement){/index.php}?{/}?", "destination": "/juridisch#privacy", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/(Klachtenprocedure|klachtenprocedure){/index.php}?{/}?", "destination": "/juridisch#klachten", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/(Neem-contact-met-mij-op|neem-contact-met-mij-op){/index.php}?{/}?", "destination": "/contact", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/(Afspraakformulier|afspraakformulier){/index.php}?{/}?", "destination": "/contact", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/(Gratis-gesprek|gratis-gesprek){/index.php}?{/}?", "destination": "/contact", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/(Tell-a-friend|tell-a-friend){/index.php}?{/}?", "destination": "/contact", "statusCode": 301 },
    { "source": "/index.php{/}?", "destination": "/", "statusCode": 301 },
    { "source": "/(Hypotheken|hypotheken)/:rest(.+)", "destination": "/diensten", "statusCode": 301 },
    { "source": "/(Verzekeringen|verzekeringen)/:rest(.+)", "destination": "/verzekeringen", "statusCode": 301 },
    { "source": "/(Meer-nieuws-tips|meer-nieuws-tips)/:rest(.+)", "destination": "/blog", "statusCode": 301 },
    { "source": "/(Over-Hypotheekhaven|over-hypotheekhaven)/:rest(.+)", "destination": "/over-sabrina", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/beheer(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
