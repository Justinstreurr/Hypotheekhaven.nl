---
interface Props {
  class: string;
  href: string;
  label?: string;
}
const { class: klasse, href, label = 'Hypotheekhaven Hypotheek & verzekeringsadvies, naar home' } = Astro.props;
---
<a href={href} class:list={[klasse, 'brand']} aria-label={label}><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 100 100"><path d="M11.5 91.5V44.5L28 35V66L56 80V27L87.5 11.5V91.5H72V36L41 51.5V91.5Z"/></svg></span><span class="brand-text"><span class="brand-name">Hypotheekhaven</span> <span class="brand-tag">Hypotheek- &amp; verzekeringsadvies</span></span></a>
