---
import { Image } from 'astro:assets';
import type { Beeld } from '../lib/content';
// Gemeten breedte van elke foto op de site (zie README: "Beeldmaten bijwerken")
import maten from '../content/beeldmaten.json';

interface Props {
  data: Beeld;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  [attr: string]: unknown;
}

const { data, sizes, loading = 'lazy', ...rest } = Astro.props;
const { src, alt, key } = data;
// foto's in een lijst delen één maat: "home:diensten-track.*.foto"
const gemeten = (maten as Record<string, string>)[key] ?? (maten as Record<string, string>)[key.replace(/\.\d+\./, '.*.')];
const breedtes = [320, 480, 640, 800, 1200, 1600, 2000].filter(b => b < src.width).concat(Math.min(src.width, 2400));
---
{src.format === 'svg'
  ? <img src={src.src} width={src.width} height={src.height} alt={alt} loading={loading} decoding="async" data-ei={key} {...rest} />
  : <Image src={src} alt={alt} widths={breedtes} sizes={gemeten ?? sizes ?? '(max-width: 767px) 100vw, 50vw'} format="webp" quality={75} loading={loading} decoding="async" data-ei={key} {...rest} />}
