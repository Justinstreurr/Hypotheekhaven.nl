---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Header from '../components/Header.astro';
import HeroReviews from '../components/HeroReviews.astro';
import HeroBanks from '../components/HeroBanks.astro';
import Footer from '../components/Footer.astro';
import BlogKaart from '../components/BlogKaart.astro';
import { artikelen, beeldBestand, CATEGORIEEN, datumTekst, laadPagina } from '../lib/content';
import '../styles/pagina.css';
import '../styles/blog.css';

const { t, bg, meta, achtergronden } = await laadPagina('blog');

// Uitgelicht: het nieuwste gepubliceerde artikel. Daaronder alle artikelen, ook de aangekondigde.
const alle = artikelen();
const uitgelicht = alle.find(a => a.artikel.status === 'gepubliceerd');
const uitgelichtFoto = uitgelicht ? uitgelicht.i.uitgelicht ?? uitgelicht.i.kaart : null!;
const uitgelichtTitel = uitgelicht?.t['titel-uitgelicht'] ? 'titel-uitgelicht' : 'titel';
const uitgelichtTekst = uitgelicht?.t['samenvatting-uitgelicht'] ? 'samenvatting-uitgelicht' : 'samenvatting';
const kaarten = [
  ...alle.filter(a => a.artikel.status === 'gepubliceerd'),
  ...alle.filter(a => a.artikel.status === 'binnenkort'),
];
---
<Base pagina="blog" meta={meta} preload={achtergronden['hero.foto1']}>
<header class="hero hero--pagina hero--blog">
  <div class="hero-slides">
    <div class="hero-slide hero-slide--blog is-active" {...bg('hero.foto1', 'background-image', '')}></div>
  </div>
  <div class="hero-overlay"></div>

  

  <Header />

  <div class="hero-content">
    <nav class="kruimelpad" aria-label="Kruimelpad"><a href="/" data-e="blog:hero.a1" set:html={t('hero.a1')}></a><span aria-hidden="true">/</span><span aria-current="page" data-e="blog:hero.span1" set:html={t('hero.span1')}></span></nav>
    <h1 data-e="blog:hero.h11" set:html={t('hero.h11')}></h1>
    <p data-e="blog:hero.p1" set:html={t('hero.p1')}></p>
  </div>
  <HeroReviews />
  <HeroBanks />
</header>

<main>

{uitgelicht && (
<section class="blog-uitgelicht container" aria-labelledby="uitgelicht-titel" data-artikel={`blog/${uitgelicht.slug}`}>
  <article class="blog-uitgelicht-kaart">
    <div class="blog-uitgelicht-beeld">
      <Img data={{ key: `blog/${uitgelicht.slug}:uitgelicht`, src: beeldBestand(uitgelichtFoto.src), alt: uitgelichtFoto.alt }} loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 1024px) 100vw, (max-width: 1600px) 60vw, 1022px" />
    </div>
    <div class="blog-uitgelicht-tekst">
      <span class="eyebrow" data-e="blog:uitgelicht.eyebrow" set:html={t('uitgelicht.eyebrow')}></span>
      <span class="blog-label">{CATEGORIEEN[uitgelicht.artikel.categorie]}</span>
      <h2 id="uitgelicht-titel"><a href={`/blog/${uitgelicht.slug}`} data-e={`blog/${uitgelicht.slug}:${uitgelichtTitel}`} set:html={uitgelicht.t[uitgelichtTitel]} /></h2>
      <p data-e={`blog/${uitgelicht.slug}:${uitgelichtTekst}`} set:html={uitgelicht.t[uitgelichtTekst]}></p>
      <div class="blog-meta">
        <time datetime={uitgelicht.artikel.datum}>{datumTekst(uitgelicht.artikel.datum)}</time><span aria-hidden="true">·</span><span data-e={`blog/${uitgelicht.slug}:leestijd`} set:html={uitgelicht.t.leestijd}></span>
      </div>
      <a href={`/blog/${uitgelicht.slug}`} class="waarom-link" aria-label={`Lees het artikel: ${uitgelicht.t.titel.replace(/<[^>]+>/g, '')}`} data-e="blog:uitgelicht.link" set:html={t('uitgelicht.link')}></a>
    </div>
  </article>
</section>
)}

<section class="blog-overzicht container" id="artikelen" aria-labelledby="artikelen-titel">
  <div class="blog-sectie-kop">
    <div>
      <span class="eyebrow" data-e="blog:artikelen.span1" set:html={t('artikelen.span1')}></span>
      <h2 id="artikelen-titel" data-e="blog:artikelen.h21" set:html={t('artikelen.h21')}></h2>
    </div>
    <div class="blog-filter" role="group" aria-label="Filter artikelen op onderwerp">
      <button type="button" class="blog-chip" data-filter="alle" aria-pressed="true" data-e="blog:artikelen.button1" set:html={t('artikelen.button1')}></button>
      <button type="button" class="blog-chip" data-filter="huis-kopen" aria-pressed="false" data-e="blog:artikelen.button2" set:html={t('artikelen.button2')}></button>
      <button type="button" class="blog-chip" data-filter="huidige-hypotheek" aria-pressed="false" data-e="blog:artikelen.button3" set:html={t('artikelen.button3')}></button>
      <button type="button" class="blog-chip" data-filter="verzekeringen" aria-pressed="false" data-e="blog:artikelen.button4" set:html={t('artikelen.button4')}></button>
      <button type="button" class="blog-chip" data-filter="ondernemers" aria-pressed="false" data-e="blog:artikelen.button5" set:html={t('artikelen.button5')}></button>
    </div>
  </div>
  <p class="blog-filter-status sr-only" aria-live="polite"></p>

  <div class="blog-raster" data-blog-raster>
    {kaarten.map(a => <BlogKaart artikel={a} />)}
  </div>
</section>

<section class="blog-cta container" aria-labelledby="cta-titel">
  <span class="eyebrow" data-e="blog:blog-cta.span1" set:html={t('blog-cta.span1')}></span>
  <h2 id="cta-titel" data-e="blog:blog-cta.h21" set:html={t('blog-cta.h21')}></h2>
  <p data-e="blog:blog-cta.p1" set:html={t('blog-cta.p1')}></p>
  <div class="btn-row">
    <a href="/contact#formulier" class="btn btn-dark" data-e="blog:blog-cta.a1" set:html={t('blog-cta.a1')}></a>
  </div>
</section>

</main>

<Footer />
<script>
  import '../scripts/blog.js';
</script>
</Base>
