---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Header from '../../components/Header.astro';
import HeroReviews from '../../components/HeroReviews.astro';
import HeroBanks from '../../components/HeroBanks.astro';
import Footer from '../../components/Footer.astro';
import BlogKaart from '../../components/BlogKaart.astro';
import { artikelen, laadPagina, lijstBeeld } from '../../lib/content';
import '../../styles/pagina.css';
import '../../styles/blog.css';

const { t, img, bg, meta, achtergronden, lijst } = await laadPagina('blog-hoeveel-kan-ik-lenen');
const alle = artikelen();
const gerelateerd = (alle.find(x => x.slug === 'hoeveel-kan-ik-lenen')?.artikel.gerelateerd ?? [])
  .map(s => alle.find(x => x.slug === s)).filter(x => x !== undefined);
---
<Base pagina="blog-hoeveel-kan-ik-lenen" meta={meta} preload={achtergronden['hero.foto1']}>
<header class="hero hero--pagina hero--artikel">
  <div class="hero-slides">
    <div class="hero-slide hero-slide--artikel is-active" {...bg('hero.foto1', 'background-image', '')}></div>
  </div>
  <div class="hero-overlay"></div>

  

  <Header />

  <div class="hero-content">
    <nav class="kruimelpad" aria-label="Kruimelpad"><a href="/" data-e="blog-hoeveel-kan-ik-lenen:hero.a1" set:html={t('hero.a1')}></a><span aria-hidden="true">/</span><a href="/blog" data-e="blog-hoeveel-kan-ik-lenen:hero.a2" set:html={t('hero.a2')}></a><span aria-hidden="true">/</span><span aria-current="page" data-e="blog-hoeveel-kan-ik-lenen:hero.span1" set:html={t('hero.span1')}></span></nav>
    <h1 id="artikel-titel" data-e="blog-hoeveel-kan-ik-lenen:hero.h11" set:html={t('hero.h11')}></h1>
    <p class="artikel-kopmeta">
      <span class="blog-label" data-e="blog-hoeveel-kan-ik-lenen:hero.span2" set:html={t('hero.span2')}></span>
      <span class="artikel-auteur-klein"><Img data={img('hero.img1')} width="600" height="592" /><span data-e="blog-hoeveel-kan-ik-lenen:hero.span3" set:html={t('hero.span3')}></span></span>
      
      <span data-e="blog-hoeveel-kan-ik-lenen:hero.span4" set:html={t('hero.span4')}></span>
      <span data-e="blog-hoeveel-kan-ik-lenen:hero.span5" set:html={t('hero.span5')}></span>
      <span data-e="blog-hoeveel-kan-ik-lenen:hero.span6" set:html={t('hero.span6')}></span>
    </p>
  </div>
  <HeroReviews />
  <HeroBanks />
</header>

<main>

<article class="artikel container" aria-labelledby="artikel-titel">
  <div class="artikel-raster">

    
    <header class="artikel-samenvatting">
      <div class="kort-antwoord" id="kort-antwoord">
        <span class="eyebrow" data-e="blog-hoeveel-kan-ik-lenen:kort-antwoord.span1" set:html={t('kort-antwoord.span1')}></span>
        <p data-e="blog-hoeveel-kan-ik-lenen:kort-antwoord.p1" set:html={t('kort-antwoord.p1')}></p>
      </div>
      <section class="in-het-kort" aria-labelledby="in-het-kort-titel">
        <h2 id="in-het-kort-titel" data-e="blog-hoeveel-kan-ik-lenen:in-het-kort.h21" set:html={t('in-het-kort.h21')}></h2>
        <ul class="vinkjes" data-el="blog-hoeveel-kan-ik-lenen:vinkjes">
          {lijst('vinkjes').map((x, n) => (
            <li data-item data-e={`blog-hoeveel-kan-ik-lenen:vinkjes.${n}.li`} set:html={x['li']}></li>
          ))}
