        <div class="tab-kaart" id="oversluiten" tabindex="0">
          <div class="tab-foto"><Img data={img('oversluiten.img1')} style="object-position: 75% center" /></div>
          <div class="tab-tekst">
            <span class="tab-nr" data-e="diensten:oversluiten.span1" set:html={t('oversluiten.span1')}></span>
