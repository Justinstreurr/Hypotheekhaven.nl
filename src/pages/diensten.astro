---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Header from '../components/Header.astro';
import HeroReviews from '../components/HeroReviews.astro';
import HeroBanks from '../components/HeroBanks.astro';
import Footer from '../components/Footer.astro';
import { laadPagina, lijstBeeld } from '../lib/content';
import '../styles/pagina.css';
import '../styles/diensten.css';

const { t, img, bg, meta, achtergronden, lijst } = await laadPagina('diensten');
---
<Base pagina="diensten" meta={meta} preload={achtergronden['hero.foto1']}>
<header class="hero hero--pagina">
  <div class="hero-slides">
    <div class="hero-slide is-active" {...bg('hero.foto1', 'background-image', 'background-position: 62% center')}></div>
  </div>
  <div class="hero-overlay"></div>

  

  <Header />

  <div class="hero-content">
    <nav class="kruimelpad" aria-label="Kruimelpad"><a href="/" data-e="diensten:hero.a1" set:html={t('hero.a1')}></a><span aria-hidden="true">/</span><span data-e="diensten:hero.span1" set:html={t('hero.span1')}></span></nav>
    <h1 data-e="diensten:hero.h11" set:html={t('hero.h11')}></h1>
    <p data-e="diensten:hero.p1" set:html={t('hero.p1')}></p>
  </div>
  <HeroReviews />
  <HeroBanks />
</header>

<main id="inhoud" tabindex="-1">

<section class="tabs container" aria-label="Diensten">
  <div class="tabs-kop">
    <span class="eyebrow" data-e="diensten:tabs.span1" set:html={t('tabs.span1')}></span>
    <h2 data-e="diensten:tabs.h21" set:html={t('tabs.h21')}></h2>
  </div>
  <div class="tabs-knoppen" role="tablist">
    <button type="button" role="tab" class="tabs-knop is-actief" aria-selected="true" aria-controls="tab-kopen" id="knop-kopen" data-e="diensten:tabs.button1" set:html={t('tabs.button1')}></button>
    <button type="button" role="tab" class="tabs-knop" aria-selected="false" aria-controls="tab-huidig" id="knop-huidig" data-e="diensten:tabs.button2" set:html={t('tabs.button2')}></button>
  </div>
  <div class="tab-paneel is-actief" id="tab-kopen" role="tabpanel" aria-labelledby="knop-kopen" data-el="diensten:tab-paneel">
        {lijst('tab-paneel').map((x, n) => (
          <div data-item class:list={['tab-kaart', { 'is-actief': n === 0 }]} id={x['anker']} tabindex="0">
            <div class="tab-foto"><Img data={lijstBeeld(x['foto'], `diensten:tab-paneel.${n}.foto`)} style={x['foto'].positie ? `object-position: ${x['foto'].positie}` : undefined} /></div>
            <div class="tab-tekst">
              <span class="tab-nr" data-e={`diensten:tab-paneel.${n}.span`} set:html={x['span']}></span>
              <h3 data-e={`diensten:tab-paneel.${n}.h3`} set:html={x['h3']}></h3>
              <div class="tab-meer">
                <p data-e={`diensten:tab-paneel.${n}.p`} set:html={x['p']}></p>
                <ul class="tab-punten">
            <li data-e={`diensten:tab-paneel.${n}.li`} set:html={x['li']}></li>
            <li data-e={`diensten:tab-paneel.${n}.li2`} set:html={x['li2']}></li>
            <li data-e={`diensten:tab-paneel.${n}.li3`} set:html={x['li3']}></li>
        </ul>
                <a href={x['link']} data-link="link" class="waarom-link" data-e={`diensten:tab-paneel.${n}.link-tekst`} set:html={x['link-tekst']}></a>
              </div>
            </div>
          </div>
        ))}
  </div>
  <div class="tab-paneel" id="tab-huidig" role="tabpanel" aria-labelledby="knop-huidig" data-el="diensten:tab-paneel-2">
        {lijst('tab-paneel-2').map((x, n) => (
          <div data-item class:list={['tab-kaart', { 'is-actief': n === 0 }]} id={x['anker']} tabindex="0">
            <div class="tab-foto"><Img data={lijstBeeld(x['foto'], `diensten:tab-paneel-2.${n}.foto`)} style={x['foto'].positie ? `object-position: ${x['foto'].positie}` : undefined} /></div>
            <div class="tab-tekst">
              <span class="tab-nr" data-e={`diensten:tab-paneel-2.${n}.span`} set:html={x['span']}></span>
              <h3 data-e={`diensten:tab-paneel-2.${n}.h3`} set:html={x['h3']}></h3>
              <div class="tab-meer">
                <p data-e={`diensten:tab-paneel-2.${n}.p`} set:html={x['p']}></p>
                <ul class="tab-punten">
            <li data-e={`diensten:tab-paneel-2.${n}.li`} set:html={x['li']}></li>
            <li data-e={`diensten:tab-paneel-2.${n}.li2`} set:html={x['li2']}></li>
            <li data-e={`diensten:tab-paneel-2.${n}.li3`} set:html={x['li3']}></li>
        </ul>
                <a href={x['link']} data-link="link" class="waarom-link" data-e={`diensten:tab-paneel-2.${n}.link-tekst`} set:html={x['link-tekst']}></a>
              </div>
            </div>
          </div>
        ))}
  </div>
</section>

<section class="reviews container" id="reviews">
  <div class="reviews-kop">
    <div><span class="eyebrow" data-e="diensten:reviews.span1" set:html={t('reviews.span1')}></span>
    <h2 data-e="diensten:reviews.h21" set:html={t('reviews.h21')}></h2></div>
    <p data-e="diensten:reviews.p1" set:html={t('reviews.p1')}></p>
  </div>

  <div class="reviews-balk">
    <div class="reviews-voortgang" aria-hidden="true"><span></span></div>
    <div class="reviews-bediening">
      <span class="reviews-teller" aria-live="polite">1/9</span>
      <div class="reviews-pijlen">
        <button class="reviews-pijl" type="button" data-dir="-1" aria-label="Vorige review"><i class="arrow arrow--terug"></i></button>
        <button class="reviews-pijl" type="button" data-dir="1" aria-label="Volgende review"><i class="arrow"></i></button>
      </div>
    </div>
  </div>

  <div class="reviews-track">
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img1')} /></span>
      <blockquote data-e="diensten:reviews.blockquote1" set:html={t('reviews.blockquote1')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption1" set:html={t('reviews.figcaption1')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img2')} /><span aria-label="5 sterren" data-e="diensten:reviews.span2" set:html={t('reviews.span2')}></span></span>
      <blockquote data-e="diensten:reviews.blockquote2" set:html={t('reviews.blockquote2')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption2" set:html={t('reviews.figcaption2')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img3')} /></span>
      <blockquote data-e="diensten:reviews.blockquote3" set:html={t('reviews.blockquote3')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption3" set:html={t('reviews.figcaption3')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img4')} /></span>
      <blockquote data-e="diensten:reviews.blockquote4" set:html={t('reviews.blockquote4')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption4" set:html={t('reviews.figcaption4')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img5')} /></span>
      <blockquote data-e="diensten:reviews.blockquote5" set:html={t('reviews.blockquote5')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption5" set:html={t('reviews.figcaption5')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img6')} /><span aria-label="5 sterren" data-e="diensten:reviews.span3" set:html={t('reviews.span3')}></span></span>
      <blockquote data-e="diensten:reviews.blockquote6" set:html={t('reviews.blockquote6')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption6" set:html={t('reviews.figcaption6')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img7')} /></span>
      <blockquote data-e="diensten:reviews.blockquote7" set:html={t('reviews.blockquote7')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption7" set:html={t('reviews.figcaption7')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img8')} /></span>
      <blockquote data-e="diensten:reviews.blockquote8" set:html={t('reviews.blockquote8')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption8" set:html={t('reviews.figcaption8')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img9')} /></span>
      <blockquote data-e="diensten:reviews.blockquote9" set:html={t('reviews.blockquote9')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption9" set:html={t('reviews.figcaption9')}></figcaption>
    </figure>
  </div>
</section>

<section class="werkwijze container" id="werkwijze">
  <div class="werkwijze-kop">
    <span class="eyebrow" data-e="diensten:werkwijze.span1" set:html={t('werkwijze.span1')}></span>
    <h2 data-e="diensten:werkwijze.h21" set:html={t('werkwijze.h21')}></h2>
    <a href="/contact#formulier" class="btn btn-dark" data-e="diensten:werkwijze.a1" set:html={t('werkwijze.a1')}></a>
  </div>

  <div class="tijdlijn">
    <div class="tijdlijn-lijn" aria-hidden="true"><div class="tijdlijn-vulling"></div></div>
    <ol class="tijdlijn-stappen">
      <li class="tijdlijn-stap">
        <div class="tijdlijn-tekst">
          <span class="tijdlijn-nr" data-e="diensten:werkwijze.span2" set:html={t('werkwijze.span2')}></span>
          <h3 data-e="diensten:werkwijze.h31" set:html={t('werkwijze.h31')}></h3>
          <p data-e="diensten:werkwijze.p1" set:html={t('werkwijze.p1')}></p>
        </div>
        <Img data={img('werkwijze.img1')} class="tijdlijn-foto" style="object-position: 62% center" />
      </li>
      <li class="tijdlijn-stap is-links">
        <div class="tijdlijn-tekst">
          <span class="tijdlijn-nr" data-e="diensten:werkwijze.span3" set:html={t('werkwijze.span3')}></span>
          <h3 data-e="diensten:werkwijze.h32" set:html={t('werkwijze.h32')}></h3>
          <p data-e="diensten:werkwijze.p2" set:html={t('werkwijze.p2')}></p>
        </div>
        <Img data={img('werkwijze.img2')} class="tijdlijn-foto" style="object-position: center 30%" />
      </li>
      <li class="tijdlijn-stap">
        <div class="tijdlijn-tekst">
          <span class="tijdlijn-nr" data-e="diensten:werkwijze.span4" set:html={t('werkwijze.span4')}></span>
          <h3 data-e="diensten:werkwijze.h33" set:html={t('werkwijze.h33')}></h3>
          <p data-e="diensten:werkwijze.p3" set:html={t('werkwijze.p3')}></p>
        </div>
        <Img data={img('werkwijze.img3')} class="tijdlijn-foto" style="object-position: center 40%" />
      </li>
      <li class="tijdlijn-stap is-links">
        <div class="tijdlijn-tekst">
          <span class="tijdlijn-nr" data-e="diensten:werkwijze.span5" set:html={t('werkwijze.span5')}></span>
          <h3 data-e="diensten:werkwijze.h34" set:html={t('werkwijze.h34')}></h3>
          <p data-e="diensten:werkwijze.p4" set:html={t('werkwijze.p4')}></p>
        </div>
        <Img data={img('werkwijze.img4')} class="tijdlijn-foto" style="object-position: center 45%" />
      </li>
      <li class="tijdlijn-label" aria-hidden="true"><span>Na de notaris</span></li>
      <li class="tijdlijn-stap tijdlijn-stap--na">
        <div class="tijdlijn-tekst">
          <h3 data-e="diensten:werkwijze.h35" set:html={t('werkwijze.h35')}></h3>
          <p data-e="diensten:werkwijze.p5" set:html={t('werkwijze.p5')}></p>
        </div>
      </li>
    </ol>
  </div>
</section>

</main>

<Footer />

<div class="hulp-cursor" aria-hidden="true"><span class="hulp-cursor-bol">Lees meer</span></div>
<script>
  import '../scripts/diensten.js';
</script>
</Base>
