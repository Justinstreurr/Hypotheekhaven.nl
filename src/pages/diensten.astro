              <a href="/contact#formulier" class="waarom-link" data-e="diensten:ondernemer.a1" set:html={t('ondernemer.a1')}></a>
            </div>
          </div>
        </div>
  </div>
  <div class="tab-paneel" id="tab-huidig" role="tabpanel" aria-labelledby="knop-huidig">
        <div class="tab-kaart is-actief" id="rentevast" tabindex="0">
          <div class="tab-foto"><Img data={img('rentevast.img1')} style="object-position: center" /></div>
          <div class="tab-tekst">
            <span class="tab-nr" data-e="diensten:rentevast.span1" set:html={t('rentevast.span1')}></span>
            <h3 data-e="diensten:rentevast.h31" set:html={t('rentevast.h31')}></h3>
            <div class="tab-meer">
              <p data-e="diensten:rentevast.p1" set:html={t('rentevast.p1')}></p>
              <ul class="tab-punten">
          <li data-e="diensten:rentevast.li1" set:html={t('rentevast.li1')}></li>
          <li data-e="diensten:rentevast.li2" set:html={t('rentevast.li2')}></li>
