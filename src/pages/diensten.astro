<section class="werkwijze container" id="werkwijze">
  <div class="werkwijze-kop">
    <span class="eyebrow" data-e="diensten:werkwijze.span1" set:html={t('werkwijze.span1')}></span>
    <h2 data-e="diensten:werkwijze.h21" set:html={t('werkwijze.h21')}></h2>
    <a href="/contact#formulier" class="btn btn-dark" data-e="diensten:werkwijze.a1" set:html={t('werkwijze.a1')}></a>
  </div>

  <div class="tijdlijn">
    <div class="tijdlijn-lijn" aria-hidden="true"><div class="tijdlijn-vulling"></div></div>
    <ol class="tijdlijn-stappen">
      <li class="tijdlijn-stap">
        <div class="tijdlijn-tekst">
          <span class="tijdlijn-nr" data-e="diensten:werkwijze.span2" set:html={t('werkwijze.span2')}></span>
          <h3 data-e="diensten:werkwijze.h31" set:html={t('werkwijze.h31')}></h3>
          <p data-e="diensten:werkwijze.p1" set:html={t('werkwijze.p1')}></p>
        </div>
        <Img data={img('werkwijze.img1')} class="tijdlijn-foto" style="object-position: 62% center" />
      </li>
      <li class="tijdlijn-stap is-links">
        <div class="tijdlijn-tekst">
          <span class="tijdlijn-nr" data-e="diensten:werkwijze.span3" set:html={t('werkwijze.span3')}></span>
          <h3 data-e="diensten:werkwijze.h32" set:html={t('werkwijze.h32')}></h3>
          <p data-e="diensten:werkwijze.p2" set:html={t('werkwijze.p2')}></p>
        </div>
        <Img data={img('werkwijze.img2')} class="tijdlijn-foto" style="object-position: center 30%" />
      </li>
      <li class="tijdlijn-stap">
        <div class="tijdlijn-tekst">
          <span class="tijdlijn-nr" data-e="diensten:werkwijze.span4" set:html={t('werkwijze.span4')}></span>
