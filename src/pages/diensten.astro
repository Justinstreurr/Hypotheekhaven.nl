  </div>
</section>

<section class="reviews container" id="reviews">
  <div class="reviews-kop">
    <div><span class="eyebrow" data-e="diensten:reviews.span1" set:html={t('reviews.span1')}></span>
    <h2 data-e="diensten:reviews.h21" set:html={t('reviews.h21')}></h2></div>
    <p data-e="diensten:reviews.p1" set:html={t('reviews.p1')}></p>
  </div>

  <div class="reviews-balk">
    <div class="reviews-voortgang" aria-hidden="true"><span></span></div>
    <div class="reviews-bediening">
      <span class="reviews-teller" aria-live="polite">1/9</span>
      <div class="reviews-pijlen">
        <button class="reviews-pijl" type="button" data-dir="-1" aria-label="Vorige review"><i class="arrow arrow--terug"></i></button>
        <button class="reviews-pijl" type="button" data-dir="1" aria-label="Volgende review"><i class="arrow"></i></button>
      </div>
    </div>
  </div>

  <div class="reviews-track">
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img1')} /></span>
      <blockquote data-e="diensten:reviews.blockquote1" set:html={t('reviews.blockquote1')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption1" set:html={t('reviews.figcaption1')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img2')} /><span aria-label="5 sterren" data-e="diensten:reviews.span2" set:html={t('reviews.span2')}></span></span>
      <blockquote data-e="diensten:reviews.blockquote2" set:html={t('reviews.blockquote2')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption2" set:html={t('reviews.figcaption2')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img3')} /></span>
      <blockquote data-e="diensten:reviews.blockquote3" set:html={t('reviews.blockquote3')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption3" set:html={t('reviews.figcaption3')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img4')} /></span>
      <blockquote data-e="diensten:reviews.blockquote4" set:html={t('reviews.blockquote4')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption4" set:html={t('reviews.figcaption4')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img5')} /></span>
      <blockquote data-e="diensten:reviews.blockquote5" set:html={t('reviews.blockquote5')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption5" set:html={t('reviews.figcaption5')}></figcaption>
    </figure>
    <figure class="review">
      <span class="review-bron"><Img data={img('reviews.img6')} /><span aria-label="5 sterren" data-e="diensten:reviews.span3" set:html={t('reviews.span3')}></span></span>
      <blockquote data-e="diensten:reviews.blockquote6" set:html={t('reviews.blockquote6')}></blockquote>
      <figcaption data-e="diensten:reviews.figcaption6" set:html={t('reviews.figcaption6')}></figcaption>
