          <li data-e="diensten:verduurzamen.li3" set:html={t('verduurzamen.li3')}></li>
      </ul>
              <a href="/contact#formulier" class="waarom-link" data-e="diensten:verduurzamen.a1" set:html={t('verduurzamen.a1')}></a>
            </div>
          </div>
        </div>
        <div class="tab-kaart" id="scheiden" tabindex="0">
          <div class="tab-foto"><Img data={img('scheiden.img1')} style="object-position: center" /></div>
          <div class="tab-tekst">
            <span class="tab-nr" data-e="diensten:scheiden.span1" set:html={t('scheiden.span1')}></span>
            <h3 data-e="diensten:scheiden.h31" set:html={t('scheiden.h31')}></h3>
            <div class="tab-meer">
