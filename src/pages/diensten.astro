---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Header from '../components/Header.astro';
import HeroReviews from '../components/HeroReviews.astro';
import HeroBanks from '../components/HeroBanks.astro';
import Footer from '../components/Footer.astro';
import { laadPagina } from '../lib/content';
import '../styles/pagina.css';
import '../styles/diensten.css';

const { t, img, bg, meta, achtergronden } = await laadPagina('diensten');
---
<Base pagina="diensten" meta={meta} preload={achtergronden['hero.foto1']}>
<header class="hero hero--pagina">
  <div class="hero-slides">
    <div class="hero-slide is-active" {...bg('hero.foto1', 'background-image', 'background-position: 62% center')}></div>
  </div>
  <div class="hero-overlay"></div>

  

  <Header />

  <div class="hero-content">
    <nav class="kruimelpad" aria-label="Kruimelpad"><a href="/" data-e="diensten:hero.a1" set:html={t('hero.a1')}></a><span aria-hidden="true">/</span><span data-e="diensten:hero.span1" set:html={t('hero.span1')}></span></nav>
    <h1 data-e="diensten:hero.h11" set:html={t('hero.h11')}></h1>
    <p data-e="diensten:hero.p1" set:html={t('hero.p1')}></p>
  </div>
  <HeroReviews />
  <HeroBanks />
</header>

<main>

<section class="tabs container" aria-label="Diensten">
  <div class="tabs-kop">
    <span class="eyebrow" data-e="diensten:tabs.span1" set:html={t('tabs.span1')}></span>
    <h2 data-e="diensten:tabs.h21" set:html={t('tabs.h21')}></h2>
  </div>
  <div class="tabs-knoppen" role="tablist">
    <button type="button" role="tab" class="tabs-knop is-actief" aria-selected="true" aria-controls="tab-kopen" id="knop-kopen" data-e="diensten:tabs.button1" set:html={t('tabs.button1')}></button>
    <button type="button" role="tab" class="tabs-knop" aria-selected="false" aria-controls="tab-huidig" id="knop-huidig" data-e="diensten:tabs.button2" set:html={t('tabs.button2')}></button>
  </div>
  <div class="tab-paneel is-actief" id="tab-kopen" role="tabpanel" aria-labelledby="knop-kopen">
        <div class="tab-kaart is-actief" id="kan-ik-kopen" tabindex="0">
          <div class="tab-foto"><Img data={img('kan-ik-kopen.img1')} style="object-position: center 62%" /></div>
          <div class="tab-tekst">
            <span class="tab-nr" data-e="diensten:kan-ik-kopen.span1" set:html={t('kan-ik-kopen.span1')}></span>
            <h3 data-e="diensten:kan-ik-kopen.h31" set:html={t('kan-ik-kopen.h31')}></h3>
            <div class="tab-meer">
              <p data-e="diensten:kan-ik-kopen.p1" set:html={t('kan-ik-kopen.p1')}></p>
              <ul class="tab-punten">
          <li data-e="diensten:kan-ik-kopen.li1" set:html={t('kan-ik-kopen.li1')}></li>
          <li data-e="diensten:kan-ik-kopen.li2" set:html={t('kan-ik-kopen.li2')}></li>
          <li data-e="diensten:kan-ik-kopen.li3" set:html={t('kan-ik-kopen.li3')}></li>
      </ul>
              <a href="/contact#formulier" class="waarom-link" data-e="diensten:kan-ik-kopen.a1" set:html={t('kan-ik-kopen.a1')}></a>
            </div>
          </div>
        </div>
        <div class="tab-kaart" id="eerste-huis" tabindex="0">
          <div class="tab-foto"><Img data={img('eerste-huis.img1')} style="object-position: center 45%" /></div>
          <div class="tab-tekst">
