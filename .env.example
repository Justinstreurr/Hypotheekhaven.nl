# Publieke instellingen
PUBLIC_SITE_URL=https://www.hypotheekhaven.nl
# Alleen op productie op "production" zetten; anders krijgen pagina's noindex
PUBLIC_ENV=production

# Bewerkmodus (/beheer)
BEHEER_WACHTWOORD=kies-een-sterk-wachtwoord
# Minimaal 32 willekeurige tekens, bijv. uit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSIE_GEHEIM=

# Publiceren vanuit de bewerkmodus: fine-grained token met "Contents: read & write" op alleen deze repo
GITHUB_TOKEN=
GITHUB_REPO=eigenaar/hypotheekhaven
GITHUB_BRANCH=main

# Contactformulier (Resend, https://resend.com)
RESEND_API_KEY=
CONTACT_AAN=info@hypotheekhaven.nl
CONTACT_VAN=Hypotheekhaven website <website@hypotheekhaven.nl>
