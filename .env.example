# Publieke instellingen
PUBLIC_SITE_URL=https://www.hypotheekhaven.nl
# Alleen op productie op "production" zetten; anders krijgen pagina's noindex
PUBLIC_ENV=production

# Bewerkmodus (/beheer)
BEHEER_WACHTWOORD=kies-een-sterk-wachtwoord
# Minimaal 32 willekeurige tekens, bijv. uit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSIE_GEHEIM=

# Publiceren vanuit de bewerkmodus: fine-grained token met "Contents: read & write" op alleen deze repo
GITHUB_TOKEN=
GITHUB_REPO=eigenaar/hypotheekhaven
GITHUB_BRANCH=main

# Contactformulier (Resend, https://resend.com)
RESEND_API_KEY=
CONTACT_AAN=info@hypotheekhaven.nl
CONTACT_VAN=Hypotheekhaven website <website@hypotheekhaven.nl>

# Statistieken (dashboard op /beheer/statistieken): koppel in Vercel via Storage een Upstash Redis-database,
# dan worden deze twee automatisch ingevuld. Lokaal worden statistieken in .data/ bewaard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Microsoft Clarity (opnames, muisbewegingen): project-ID van clarity.microsoft.com.
# Zodra dit is ingevuld, verschijnt de cookiebanner en wordt Clarity alleen na toestemming geladen.
PUBLIC_CLARITY_ID=

# Cookiebot (gecertificeerde cookiebanner met Google Consent Mode v2): het "Domain Group ID" uit cookiebot.com
# (Instellingen > Uw scripts, de waarde van data-cbid). Zodra dit is ingevuld, vervangt Cookiebot de eigen banner.
PUBLIC_COOKIEBOT_ID=
# Google Analytics 4: meet-ID van de webdatastream (begint met G-). Werkt alleen samen met PUBLIC_COOKIEBOT_ID
# (nooit zonder cookiebanner), alleen met PUBLIC_ENV=production en pas na toestemming voor statistieken.
# Testen buiten productie: open een pagina met ?ga-debug (zichtbaar in GA4 > Beheer > DebugView); dat geldt ook voor Clarity.
PUBLIC_GA_ID=
